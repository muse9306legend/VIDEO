# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 키를 넣으세요. (.env 는 GitHub 에 올라가지 않습니다)
# Claude 키 - 그림과 쌍둥이 반응을 어디에 넣을지 계획합니다. https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ChatGPT(OpenAI) 키 - 설명 그림과 쌍둥이 캐릭터를 그립니다. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# (선택) 이미지 모델 (기본 gpt-image-2, 안 되면 gpt-image-1 로 자동 전환)
# OPENAI_IMAGE_MODEL=gpt-image-2

# (선택) 그림 동시 생성 개수 (기본 6). 요청 한도 오류(429)가 나면 낮추세요.
# OPENAI_IMAGE_CONCURRENCY=6

# (선택) Claude 모델 / 음성 인식 모델
# CLAUDE_MODEL=claude-opus-5-5
# WHISPER_MODEL=large-v3
