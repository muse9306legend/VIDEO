# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 키를 넣으세요. (.env 는 GitHub 에 올라가지 않습니다)
# https://console.anthropic.com → API Keys 에서 발급
ANTHROPIC_API_KEY=

# 설명 그림 생성용 ChatGPT(OpenAI) 키 — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# (선택) 사용할 이미지 모델 (기본 gpt-image-2, 안 되면 gpt-image-1 로 자동 전환)
# OPENAI_IMAGE_MODEL=gpt-image-2

# (선택) 사용할 Claude 모델
# CLAUDE_MODEL=claude-opus-5-5
